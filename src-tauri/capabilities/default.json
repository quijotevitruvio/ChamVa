{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-opened-file",
    "allow-native-media-status",
    "allow-native-media-pick",
    "allow-native-media-take-dropped",
    "allow-native-media-probe",
    "allow-native-media-proxy",
    "allow-native-media-extract-audio",
    "allow-native-media-cancel",
    "allow-native-media-read",
    "allow-native-media-cache-clear",
    "allow-native-media-hw-encoders",
    "allow-native-media-frames-open",
    "allow-native-media-frames-read",
    "allow-native-media-frames-close",
    "allow-native-media-hw-export-open",
    "allow-native-media-hw-export-write",
    "allow-native-media-hw-export-write-audio",
    "allow-native-media-hw-export-finish",
    "allow-native-media-hw-export-abort",
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-decorated",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-seek",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$VIDEO/**"
        }
      ]
    }
  ]
}
